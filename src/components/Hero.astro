---
import { site } from '../site.config';
---
<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <div aria-hidden="true" class="pointer-events-none absolute -top-40 -right-40 h-[32rem] w-[32rem] rounded-full bg-blush-200/50 blur-3xl"></div>
  <div class="container-x relative grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-[1.05fr_1fr] lg:py-24">
    <div>
      <p class="eyebrow">Hair studio · South-East Qld (demo)</p>
      <h1 id="hero-title" class="mt-4 text-[2.75rem] leading-[1.05] font-semibold tracking-tight sm:text-6xl lg:text-7xl">
        Hair that feels <em class="font-normal text-terra-600 italic">like you.</em>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted sm:text-xl">
        Thoughtful cuts, lived-in colour and treatments that survive Queensland humidity — in a calm studio where nobody rushes you.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#book" class="btn btn-primary">Book an appointment</a>
        <a href="#services" class="btn btn-ghost">View services</a>
      </div>
      <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-euc-700">
        <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-terra-500" aria-hidden="true"></span>Late night Thursdays</li>
        <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-terra-500" aria-hidden="true"></span>Book online 24/7</li>
        <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-terra-500" aria-hidden="true"></span>Free street parking</li>
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-md lg:max-w-none">
      <svg viewBox="0 0 520 560" width="520" height="560" class="h-auto w-full" role="img" aria-labelledby="hero-art-title">
        <title id="hero-art-title">Abstract illustration of flowing hair in green, cream and terracotta tones</title>
        <defs>
          <linearGradient id="h-bg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#2f4a3a" />
            <stop offset="1" stop-color="#1a2a21" />
          </linearGradient>
          <linearGradient id="h-hair" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#8a3b25" />
            <stop offset="0.55" stop-color="#c0674a" />
            <stop offset="1" stop-color="#e9b8a6" />
          </linearGradient>
          <linearGradient id="h-hair2" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#e9b8a6" />
            <stop offset="1" stop-color="#f3e9d8" />
          </linearGradient>
        </defs>
        <rect x="30" y="20" width="460" height="520" rx="230" fill="url(#h-bg)" />
        <circle cx="400" cy="110" r="52" fill="#e9b8a6" opacity="0.9" />
        <!-- profile silhouette -->
        <path d="M262 150c-58 0-100 46-100 104 0 30 10 54 28 72l-8 34c-2 8 4 14 12 14h22l4 34c2 14 14 22 28 20l30-4 10 56h86l-12-86c26-22 44-56 44-96 0-82-60-148-144-148Z" fill="#f3e9d8" opacity="0.14" />
        <!-- hair flow -->
        <path d="M250 120c90-20 170 40 176 130 6 86-34 150-20 230-60-36-84-110-70-182-30 60-26 120 2 182-76-46-104-146-80-220-40 40-56 96-46 150-50-56-60-150-8-226 12-18 28-44 46-64Z" fill="url(#h-hair)" />
        <path d="M282 150c50 4 96 46 100 106 2 40-14 74-10 120" fill="none" stroke="#f3e9d8" stroke-width="3" stroke-linecap="round" opacity="0.55" />
        <path d="M262 170c34 18 56 56 52 104-2 30-16 60-10 96" fill="none" stroke="#f3e9d8" stroke-width="2.5" stroke-linecap="round" opacity="0.4" />
        <path d="M240 200c22 26 26 60 16 92" fill="none" stroke="#f3e9d8" stroke-width="2" stroke-linecap="round" opacity="0.35" />
        <!-- ivy sprig -->
        <g transform="translate(96 380)">
          <path d="M0 120C30 80 60 40 110 0" fill="none" stroke="#8fac97" stroke-width="3" stroke-linecap="round" />
          <path d="M30 82c-18-4-28-18-26-34 18 2 28 16 26 34Z" fill="#8fac97" />
          <path d="M52 56c4-18 20-28 36-24-4 18-20 28-36 24Z" fill="#a9c2ae" />
          <path d="M72 32c-14-10-16-26-8-38 14 10 16 26 8 38Z" fill="#8fac97" />
        </g>
        <!-- scissors -->
        <g transform="translate(360 420) rotate(-30)" fill="none" stroke="url(#h-hair2)" stroke-width="5" stroke-linecap="round">
          <circle cx="0" cy="0" r="14" />
          <circle cx="0" cy="40" r="14" />
          <path d="M12 8 72 34M12 32 72 6" />
        </g>
      </svg>
      <p class="absolute -bottom-2 left-2 rounded-full bg-cream-50 px-4 py-2 text-sm font-semibold text-euc-800 shadow-lg shadow-euc-900/10 sm:left-6">
        Est. 2026 · totally fictional
      </p>
    </div>
  </div>
</section>
