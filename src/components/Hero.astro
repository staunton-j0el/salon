---
import Snip from './Snip.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container-x hero-copy">
    <p class="hero-kicker">Hair studio · South-East Qld (demo)</p>
    <div class="hero-text">
      <h1 id="hero-title" class="hero-title">
        <span class="hero-line hero-line-hair">Hair</span>
        <span class="hero-line hero-line-that">that <Snip word="feels" variant="hero" italic /></span>
        <span class="hero-line hero-line-you">
          <em class="hero-em">like you.<span class="burn" aria-hidden="true"><span class="burn-line"></span><span class="spark-trail"><i style="--i:0"></i><i style="--i:1"></i><i style="--i:2"></i><i style="--i:3"></i><i style="--i:4"></i><i style="--i:5"></i><i style="--i:6"></i></span><span class="burn-rig"><span class="flames"><i></i><i></i><i></i><i></i></span><svg class="dryer" viewBox="0 0 72 42" width="48" height="28" fill="none"><rect x="6" y="12" width="28" height="18" rx="8" fill="#fdf9f8" stroke="currentColor" stroke-width="2"></rect><path d="M34 15h14c2.2 0 4.2 1.6 6.2 4.4 1.6 2.2 1.6 5.6 0 7.8-2 2.8-4 4.8-6.2 4.8H34" fill="#f4dfe1" stroke="currentColor" stroke-width="2"></path><path d="M12 17.5h14M12 21.5h14M12 25.5h10" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"></path><path d="M16 30c-0.6 6.2 2.2 9.6 8 10.6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg></span></span></em>
        </span>
      </h1>
      <p class="hero-lede">
        Thoughtful cuts, lived-in colour and treatments that survive Queensland humidity — in a calm studio where nobody rushes you.
      </p>
      <div class="hero-actions">
        <a href="#book" class="btn btn-primary">Book an appointment</a>
        <a href="#services" class="btn btn-ghost">View services</a>
      </div>
      <ul class="hero-facts">
        <li>Late night Thursdays</li>
        <li>Book online 24/7</li>
        <li>Free street parking</li>
      </ul>
      <p class="est-badge">Est. 2026 · totally fictional</p>
    </div>
  </div>

  <div class="hero-art">
    <svg viewBox="0 0 640 820" width="640" height="820" role="img" aria-labelledby="hero-art-title">
      <title id="hero-art-title">Abstract illustration of flowing hair in plum, blush and rose tones</title>
      <defs>
        <linearGradient id="panel" x1="0" y1="0" x2="0.2" y2="1">
          <stop offset="0" stop-color="#4a2340"></stop>
          <stop offset="1" stop-color="#2a1426"></stop>
        </linearGradient>
      </defs>
      <rect x="118" y="16" width="500" height="788" rx="230" fill="url(#panel)"></rect>
      <circle cx="500" cy="118" r="42" fill="#e8b4bc"></circle>
      <g class="hair-sway">
        <path class="strand" pathLength="1" style="--d:0.05s" stroke="#722b42" stroke-width="18" d="M230 36C300 150 175 250 230 390C285 530 185 650 255 800"></path>
        <path class="strand" pathLength="1" style="--d:0.18s" stroke="#8c3550" stroke-width="12" d="M275 22C360 145 230 270 300 415C365 555 255 670 325 805"></path>
        <path class="strand" pathLength="1" style="--d:0.32s" stroke="#c76a80" stroke-width="9" d="M325 40C415 165 295 295 365 445C430 585 330 690 400 800"></path>
        <path class="strand" pathLength="1" style="--d:0.46s" stroke="#e8b4bc" stroke-width="7" d="M380 28C475 160 365 310 440 465C505 610 420 705 475 792"></path>
        <path class="strand" pathLength="1" style="--d:0.58s" stroke="#f3e7e6" stroke-width="4" d="M300 78C365 190 270 315 325 455C375 575 300 675 345 770"></path>
        <path class="strand" pathLength="1" style="--d:0.7s" stroke="#d4b072" stroke-width="3" d="M210 110C265 230 190 350 245 490C290 610 225 700 270 785"></path>
        <path class="strand" pathLength="1" style="--d:0.84s" stroke="#faf3f2" stroke-width="2.5" d="M420 90C490 200 410 330 470 480C520 610 455 700 500 775"></path>
      </g>
      <g transform="translate(150 600)">
        <path d="M8 150C40 100 78 48 130 8" fill="none" stroke="#c99bb8" stroke-width="3" stroke-linecap="round"></path>
        <path d="M46 104c-16-4-28-18-24-34 16 2 28 16 24 34Z" fill="#c99bb8"></path>
        <path d="M74 68c6-16 22-26 36-20-6 16-22 26-36 20Z" fill="#e1c0d4"></path>
        <path d="M102 34c-12-10-16-26-6-38 14 10 18 26 6 38Z" fill="#c99bb8"></path>
      </g>
    </svg>
  </div>
</section>
