---
import { site } from '../site.config';
import Snip from './Snip.astro';
---
<section id="team" class="band" aria-labelledby="team-title">
  <div class="container-x">
    <header class="team-head">
      <p class="sec-no" aria-hidden="true">03</p>
      <div>
        <p class="ink-label">Team</p>
        <h2 id="team-title" class="display">Meet the <Snip word="stylists" italic /></h2>
        <p class="team-flag">Fictional people — illustrated, not photographed</p>
      </div>
    </header>
    <ul class="roster" role="list">
      {
        site.team.map((member, index) => (
          <li class={`person person-${index}`}>
            <svg
              class="avatar"
              width={index === 0 ? 104 : 84}
              height={index === 0 ? 104 : 84}
              viewBox="0 0 88 88"
              role="img"
              aria-label={`Illustrated avatar with the initials ${member.initials}`}
            >
              <circle cx="44" cy="44" r="44" fill={member.accent}></circle>
              <path d="M14 76a34 34 0 0 1 60 0" fill={member.color} opacity="0.25"></path>
              <text
                x="44"
                y="44"
                dy="0.35em"
                text-anchor="middle"
                font-family="Georgia, serif"
                font-size="30"
                font-weight="700"
                fill={member.color}>{member.initials}</text>
            </svg>
            <h3>{member.name}</h3>
            <p class="role">{member.role}</p>
            <p class="bio">{member.bio}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
