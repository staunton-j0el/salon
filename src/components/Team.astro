---
import { site } from '../site.config';
---
<section id="team" class="section bg-plum-800 text-porcelain-100" aria-labelledby="team-title">
  <div class="container-x">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow text-blush-300">Team</p>
        <h2 id="team-title" class="section-title text-porcelain-50">Meet the stylists</h2>
      </div>
      <p class="w-fit rounded-full border border-plum-500 px-4 py-2 text-sm font-semibold text-porcelain-100">
        Fictional people — illustrated, not photographed
      </p>
    </div>
    <ul class="mt-12 grid gap-6 md:grid-cols-3" role="list">
      {site.team.map((m) => (
        <li class="rounded-3xl bg-plum-700/60 p-7 ring-1 ring-plum-500/50">
          <svg width="88" height="88" viewBox="0 0 88 88" role="img" aria-label={`Illustrated avatar with the initials ${m.initials}`}>
            <circle cx="44" cy="44" r="44" fill={m.accent} />
            <path d="M14 76a34 34 0 0 1 60 0" fill={m.color} opacity="0.25" />
            <text x="44" y="44" dy="0.35em" text-anchor="middle" font-family="Georgia, serif" font-size="30" font-weight="700" fill={m.color}>{m.initials}</text>
          </svg>
          <h3 class="mt-5 text-2xl font-semibold text-porcelain-50">{m.name}</h3>
          <p class="mt-1 text-sm font-semibold tracking-wide text-blush-200 uppercase">{m.role}</p>
          <p class="mt-4 leading-relaxed text-porcelain-200">{m.bio}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
