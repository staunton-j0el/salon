---
import { site } from '../site.config';
---
<section id="hours" class="section bg-porcelain-50" aria-labelledby="hours-title">
  <div class="container-x grid gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
      <p class="eyebrow">Hours &amp; location</p>
      <h2 id="hours-title" class="section-title">Drop by (in theory)</h2>
      <table class="mt-8 w-full text-left">
        <caption class="sr-only">Opening hours</caption>
        <thead class="sr-only">
          <tr><th scope="col">Day</th><th scope="col">Hours</th></tr>
        </thead>
        <tbody class="divide-y divide-plum-100">
          {site.hours.map((h) => (
            <tr class:list={[h.open ? '' : 'text-muted']}>
              <th scope="row" class="py-3.5 pr-4 font-semibold text-plum-800">{h.day}</th>
              <td class="py-3.5 text-right">
                {'note' in h && h.note && (
                  <>
                    <span class="mr-2 rounded-full bg-blush-100 px-2.5 py-1 text-xs font-semibold text-blush-700">{h.note}</span>{' '}
                  </>
                )}
                {h.display}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="mt-8 space-y-3 text-muted">
        <p class="flex items-start gap-3">
          <svg class="mt-0.5 shrink-0 text-plum-700" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
          <span>{site.location}</span>
        </p>
        <p class="flex items-start gap-3">
          <svg class="mt-0.5 shrink-0 text-plum-700" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4" /><path d="M9 17V7h4a3 3 0 0 1 0 6H9" /></svg>
          <span><strong class="text-ink">Free street parking</strong> — {site.parking}</span>
        </p>
      </div>
    </div>

    <div class="relative min-h-80 overflow-hidden rounded-3xl border border-plum-100 bg-[#f6ecf0]" role="img" aria-label="Map placeholder — a Google Map would go here">
      <svg class="absolute inset-0 h-full w-full" viewBox="0 0 600 480" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="600" height="480" fill="#f6ecf0" />
        <path d="M0 360c120-30 200 20 320-10s200-80 280-60v190H0Z" fill="#f1dde2" />
        <path d="M420 0c-10 80 30 140 10 220s30 140 20 260h150V0Z" fill="#e3dcec" />
        <g stroke="#ffffff" stroke-width="18" fill="none" stroke-linecap="round">
          <path d="M-20 140h640" /><path d="M-20 300c200-10 400 20 640-20" /><path d="M160-20v520" /><path d="M330-20c-20 160 30 320 0 520" />
        </g>
        <g stroke="#fbf1ec" stroke-width="7" fill="none">
          <path d="M-20 220h640" /><path d="M250-20v520" /><path d="M60-20l120 520" /><path d="M-20 420h640" />
        </g>
        <g fill="#f0dde8"><rect x="30" y="40" width="100" height="70" rx="8" /><rect x="190" y="170" width="44" height="100" rx="8" /><rect x="350" y="160" width="60" height="50" rx="8" /></g>
      </svg>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-full" aria-hidden="true">
        <svg width="48" height="60" viewBox="0 0 48 60"><path d="M24 58S4 36 4 22a20 20 0 0 1 40 0c0 14-20 36-20 36Z" fill="#a8445f" /><circle cx="24" cy="22" r="8" fill="#faf3f2" /></svg>
      </div>
      <p class="absolute inset-x-4 bottom-4 rounded-2xl bg-porcelain-50/95 px-4 py-3 text-center text-sm font-semibold text-plum-800 shadow">
        Map placeholder — a Google Map would go here
      </p>
    </div>
  </div>
</section>
