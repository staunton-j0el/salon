---
import { site } from '../site.config';
---
<section id="hours" class="band" aria-labelledby="hours-title">
  <div class="container-x hours-grid">
    <div>
      <p class="sec-no" aria-hidden="true">05</p>
      <h2 id="hours-title" class="display">Drop by <em>(in theory)</em></h2>
      <p class="hours-label">Hours &amp; location</p>
      <table class="hours-table">
        <caption class="sr-only">Opening hours</caption>
        <thead class="sr-only">
          <tr><th scope="col">Day</th><th scope="col">Hours</th></tr>
        </thead>
        <tbody>
          {
            site.hours.map((day) => (
              <tr class:list={[{ 'is-closed': !day.open, 'is-late': 'note' in day && day.note }]}>
                <th scope="row">{day.day}</th>
                <td>
                  {'note' in day && day.note ? (
                    <>
                      <span class="late-pill">{day.note}</span>{' '}
                    </>
                  ) : null}
                  {day.display}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <div class="hours-notes">
        <p>
          <svg class="mt-0.5 shrink-0 text-plum-800" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
          <span>{site.location}</span>
        </p>
        <p>
          <svg class="mt-0.5 shrink-0 text-plum-800" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M9 17V7h4a3 3 0 0 1 0 6H9"></path></svg>
          <span><strong class="text-ink">Free street parking</strong>{' '}— {site.parking}</span>
        </p>
      </div>
    </div>

    <div class="map-card" role="img" aria-label="Map placeholder — a Google Map would go here">
      <svg class="basemap" viewBox="0 0 600 480" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="600" height="480" fill="#f6ecf0"></rect>
        <path d="M0 360c120-30 200 20 320-10s200-80 280-60v190H0Z" fill="#f1dde2"></path>
        <path d="M420 0c-10 80 30 140 10 220s30 140 20 260h150V0Z" fill="#e3dcec"></path>
        <g stroke="#ffffff" stroke-width="18" fill="none" stroke-linecap="round">
          <path d="M-20 140h640"></path>
          <path d="M-20 300c200-10 400 20 640-20"></path>
          <path d="M160-20v520"></path>
          <path d="M330-20c-20 160 30 320 0 520"></path>
        </g>
        <g stroke="#fbf1ec" stroke-width="7" fill="none">
          <path d="M-20 220h640"></path>
          <path d="M250-20v520"></path>
          <path d="M60-20l120 520"></path>
          <path d="M-20 420h640"></path>
        </g>
        <g fill="#f0dde8">
          <rect x="30" y="40" width="100" height="70"></rect>
          <rect x="190" y="170" width="44" height="100"></rect>
          <rect x="350" y="160" width="60" height="50"></rect>
        </g>
      </svg>
      <div class="map-pin" aria-hidden="true">
        <svg width="48" height="60" viewBox="0 0 48 60"><path d="M24 58S4 36 4 22a20 20 0 0 1 40 0c0 14-20 36-20 36Z" fill="#a8445f"></path><circle cx="24" cy="22" r="8" fill="#faf3f2"></circle></svg>
      </div>
      <p class="map-caption">Map placeholder — a Google Map would go here</p>
    </div>
  </div>
</section>
