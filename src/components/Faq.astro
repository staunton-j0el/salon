---
import { site } from '../site.config';
---
<section id="faq" class="band" aria-labelledby="faq-title">
  <div class="container-x faq-wrap">
    <header class="faq-head">
      <p class="faq-kicker">FAQ</p>
      <div>
        <p class="sec-no" aria-hidden="true">07</p>
        <h2 id="faq-title" class="display">Good questions</h2>
      </div>
    </header>
    <div class="faq-list">
      {
        site.faq.map((item) => (
          <details class="faq-item">
            <summary>
              <span>{item.q}</span>
              <span class="faq-plus" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 2v12M2 8h12"></path></svg>
              </span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
