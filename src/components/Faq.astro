---
import { site } from '../site.config';
---
<section id="faq" class="section bg-cream-50" aria-labelledby="faq-title">
  <div class="container-x max-w-3xl">
    <p class="eyebrow">FAQ</p>
    <h2 id="faq-title" class="section-title">Good questions</h2>
    <div class="mt-10 divide-y divide-euc-100 border-y border-euc-100">
      {site.faq.map((f) => (
        <details class="faq group">
          <summary class="flex min-h-14 items-center justify-between gap-4 py-4 text-lg font-semibold text-euc-800">
            <span>{f.q}</span>
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-euc-50 text-euc-700 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 2v12M2 8h12" /></svg>
            </span>
          </summary>
          <p class="pb-6 leading-relaxed text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
