---
import { site } from '../site.config';
import Snip from './Snip.astro';

/** Plate number for a gallery tile, from 01. */
function plate(index: number): string {
  return String(index + 1).padStart(2, '0');
}
---
<section id="gallery" class="band" aria-labelledby="gallery-title">
  <div class="container-x">
    <header class="gallery-head">
      <p class="gallery-kicker">Gallery</p>
      <h2 id="gallery-title" class="display">A little <Snip word="inspiration" italic /></h2>
      <p class="gallery-lede">
        Original illustrations standing in for real work — on a live site, this is where the salon's own photos would go.
      </p>
    </header>
    <ul class="mag" role="list">
      {
        site.gallery.map((img, index) => (
          <li class={`mag-item mag-${index}`}>
            <figure>
              <div class="frame">
                <img
                  src={img.src}
                  alt={img.alt}
                  width="400"
                  height="500"
                  loading="lazy"
                  decoding="async"
                />
                <span class="mag-no" aria-hidden="true">{plate(index)}</span>
              </div>
              <figcaption>{img.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
