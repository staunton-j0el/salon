---
import { site } from '../site.config';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <p class="footer-watermark" aria-hidden="true">Ironbark</p>
  <div class="container-x footer-top">
    <div>
      <Logo light />
      <p class="footer-tag">
        A calm, colour-loving hair studio — that only exists as a website concept.
      </p>
      <p class="footer-demo">
        <strong>Demo / concept only.</strong> Ironbark &amp; Ivy Hair Studio is a fictional business. There is no real salon, phone number, address or booking system behind this site. Names, reviews and prices are examples.
      </p>
    </div>
    <div class="footer-cols">
      <nav aria-label="Footer">
        <h2>Explore</h2>
        <ul>
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div>
        <h2>Visit</h2>
        <p class="mt-2">{site.location}</p>
        <p class="mt-2">Tue–Sat · Late night Thursday</p>
        <a href="/#book" class="btn btn-primary mt-4">Book online</a>
      </div>
    </div>
  </div>
  <div class="container-x footer-bottom">
    <p>© {year} {site.name} (fictional demo).</p>
    <p>
      Website concept by{' '}
      <a href={site.agency.url}>{site.agency.name}</a>
    </p>
  </div>
</footer>
