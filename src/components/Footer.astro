---
import { site } from '../site.config';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="bg-euc-900 text-cream-100">
  <div class="container-x grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo light />
      <p class="mt-4 max-w-sm text-cream-200">
        A calm, colour-loving hair studio — that only exists as a website concept.
      </p>
      <p class="mt-4 max-w-sm rounded-xl border border-euc-500 p-4 text-sm text-cream-200">
        <strong class="text-cream-50">Demo / concept only.</strong> Ironbark &amp; Ivy Hair Studio is a fictional business. There is no real salon, phone number, address or booking system behind this site. Names, reviews and prices are examples.
      </p>
    </div>
    <nav aria-label="Footer">
      <h2 class="font-serif text-lg text-cream-50">Explore</h2>
      <ul class="mt-3">
        {site.nav.map((item) => (
          <li>
            <a href={item.href} class="inline-flex min-h-11 items-center text-cream-200 underline-offset-4 hover:text-white hover:underline">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div>
      <h2 class="font-serif text-lg text-cream-50">Visit</h2>
      <p class="mt-3 text-cream-200">{site.location}</p>
      <p class="mt-2 text-cream-200">Tue–Sat · Late night Thursday</p>
      <a href="/#book" class="btn btn-primary mt-5">Book online</a>
    </div>
  </div>
  <div class="border-t border-euc-700">
    <div class="container-x flex flex-col gap-2 py-6 text-sm text-cream-200 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name} (fictional demo).</p>
      <p>
        Website concept by{' '}
        <a href={site.agency.url} class="inline-block py-2 font-semibold text-blush-200 underline underline-offset-2 hover:text-white">{site.agency.name}</a>
      </p>
    </div>
  </div>
</footer>
