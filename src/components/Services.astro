---
import { site } from '../site.config';
import Scissors from './Scissors.astro';

/** Two-digit index for a service group, used as a decorative menu number. */
function groupNo(index: number): string {
  return String(index + 1).padStart(2, '0');
}
---
<section id="services" class="band band-ink" aria-labelledby="services-title">
  <div class="container-x">
    <header class="menu-head">
      <p class="sec-no" aria-hidden="true">01</p>
      <div>
        <p class="ink-label">Services</p>
        <h2 id="services-title" class="display">Cuts, <em>colour</em> &amp; care</h2>
      </div>
      <p class="stamp">Example prices (AUD) — demo only</p>
    </header>

    <div class="menu">
      {
        site.services.map((group, index) => (
          <article class="menu-group">
            <div class="menu-group-name">
              <p class="menu-index" aria-hidden="true">{groupNo(index)}</p>
              <h3>{group.group}</h3>
              <p class="menu-blurb">{group.blurb}</p>
            </div>
            <dl>
              {group.items.map((item) => (
                <div class="menu-row" tabindex="0">
                  <dt>
                    <span>{item.name}</span>
                  </dt>
                  <dd>{item.price}</dd>
                  <Scissors class="row-scissors" />
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>
    <p class="fineprint">
      Prices are examples for this demo only and include GST. "From" prices vary with length and thickness.
    </p>
  </div>
</section>
