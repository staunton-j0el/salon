---
import { site } from '../site.config';
const icons: Record<string, string> = {
  Cuts: 'M6 7a3 3 0 1 0 0-.01M6 17a3 3 0 1 0 0-.01M8.5 8.5 20 17M8.5 15.5 20 7',
  Colour: 'M12 3c3 4 6 7.5 6 11a6 6 0 0 1-12 0c0-3.5 3-7 6-11Z',
  Styling: 'M4 20c4-2 6-6 6-10S8 4 12 3c4 1 2 3 2 7s2 8 6 10',
  Treatments: 'M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6',
};
---
<section id="services" class="section bg-cream-50" aria-labelledby="services-title">
  <div class="container-x">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">Services</p>
        <h2 id="services-title" class="section-title">Cuts, colour &amp; care</h2>
      </div>
      <p class="inline-flex w-fit items-center gap-2 rounded-full bg-blush-100 px-4 py-2 text-sm font-semibold text-terra-700">
        <span aria-hidden="true">●</span> Example prices (AUD) — demo only
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {site.services.map((group) => (
        <article class="rounded-3xl border border-euc-100 bg-white p-6 shadow-sm shadow-euc-900/5 sm:p-8">
          <div class="flex items-center gap-4">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-euc-50 text-euc-700" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={icons[group.group]} /></svg>
            </span>
            <h3 class="text-2xl font-semibold">{group.group}</h3>
          </div>
          <p class="mt-3 text-muted">{group.blurb}</p>
          <dl class="mt-6 divide-y divide-dashed divide-euc-100">
            {group.items.map((item) => (
              <div class="flex items-baseline justify-between gap-4 py-3">
                <dt class="font-medium text-ink">{item.name}</dt>
                <dd class="shrink-0 font-serif text-lg font-semibold text-euc-700">{item.price}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>
    <p class="mt-8 text-sm text-muted">
      Prices are examples for this demo only and include GST. "From" prices vary with length and thickness.
    </p>
  </div>
</section>
