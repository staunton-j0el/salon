---
import { site } from '../site.config';
---
<section id="book" class="band" aria-labelledby="book-title">
  <div class="container-x book-grid">
    <div class="book-copy">
      <p class="book-giant">Book</p>
      <h2 id="book-title" class="display">Request an <em>appointment</em></h2>
      <p class="book-lede">
        Tell us what you're after and when suits, and we'll confirm a time. New clients welcome.
      </p>
      <div class="real-note">
        <h3>How a real salon site would do this</h3>
        <p>
          On a live site, the "Book now" buttons would link straight to the salon's online booking system — for example
          Fresha, Timely, Kitomba or Square Appointments — so clients can pick a stylist and time slot, pay a deposit and
          get SMS reminders. This form shows a simple enquiry alternative.
        </p>
      </div>
    </div>

    <form id="booking-form" class="book-form" novalidate>
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label for="bf-name" class="field-label">Name <span class="text-blush-700" aria-hidden="true">*</span></label>
          <input id="bf-name" name="name" type="text" autocomplete="name" required class="field" />
        </div>
        <div>
          <label for="bf-email" class="field-label">Email <span class="text-blush-700" aria-hidden="true">*</span></label>
          <input id="bf-email" name="email" type="email" autocomplete="email" required class="field" />
        </div>
        <div>
          <label for="bf-phone" class="field-label">Phone <span class="font-normal text-muted">(optional)</span></label>
          <input id="bf-phone" name="phone" type="tel" autocomplete="tel" class="field" />
        </div>
        <div class="sm:col-span-2">
          <label for="bf-service" class="field-label">Service <span class="text-blush-700" aria-hidden="true">*</span></label>
          <select id="bf-service" name="service" required class="field">
            <option value="">Choose a service…</option>
            {
              site.services.map((group) => (
                <optgroup label={group.group}>
                  {group.items.map((item) => (
                    <option value={item.name}>{item.name} ({item.price})</option>
                  ))}
                </optgroup>
              ))
            }
            <option value="Not sure">Not sure — I'd like a consultation</option>
          </select>
        </div>
        <div>
          <label for="bf-day" class="field-label">Preferred day</label>
          <select id="bf-day" name="day" class="field">
            <option value="">Any day</option>
            {site.hours.filter((day) => day.open).map((day) => <option value={day.day}>{day.day}</option>)}
          </select>
        </div>
        <div>
          <label for="bf-time" class="field-label">Preferred time</label>
          <select id="bf-time" name="time" class="field">
            <option value="">Any time</option>
            <option>Morning</option>
            <option>Midday</option>
            <option>Afternoon</option>
            <option>Evening (Thursday only)</option>
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="bf-notes" class="field-label">Notes</label>
          <textarea id="bf-notes" name="notes" rows="4" class="field" placeholder="Hair length, colour history, inspiration…"></textarea>
        </div>
      </div>
      <p class="mt-4 text-sm text-muted"><span class="text-blush-700" aria-hidden="true">*</span> Required</p>
      <button type="submit" class="btn btn-primary mt-6 w-full sm:w-auto">Send booking request</button>
      <div id="booking-status" role="status" aria-live="polite" class="mt-5 empty:hidden"></div>
    </form>
  </div>
</section>

<script>
  // Demo only: never sends anything anywhere.
  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const status = document.getElementById('booking-status');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!status || !form) return;
    if (!form.checkValidity()) {
      const firstInvalid = form.querySelector<HTMLElement>(':invalid');
      status.className = 'mt-5 border border-blush-600 bg-blush-100 p-4 font-medium text-blush-800';
      status.textContent = 'Please fill in your name, a valid email and a service.';
      firstInvalid?.focus();
      return;
    }
    status.className = 'mt-5 border border-plum-300 bg-plum-50 p-4 font-medium text-plum-800';
    status.textContent =
      "This is a demo — no booking was sent. On a real site this would go to the salon's booking system.";
  });
</script>
