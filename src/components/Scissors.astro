---
/** Small open scissors, used as a decorative mark. Always hidden from assistive tech. */
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---
<svg class:list={['scissors', cls]} viewBox="0 0 72 40" fill="none" aria-hidden="true">
  <circle cx="15" cy="11" r="8" stroke="currentColor" stroke-width="3"></circle>
  <circle cx="15" cy="29" r="8" stroke="currentColor" stroke-width="3"></circle>
  <path d="M22 14.5 66 23.5M22 25.5 66 16.5" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
</svg>
