---
import { site } from '../site.config';
const [lead, ...rest] = site.reviews;
---
<section id="reviews" class="band band-blush" aria-labelledby="reviews-title">
  <div class="container-x review-layout">
    <div class="review-intro">
      <p class="kind-words">Kind words</p>
      <h2 id="reviews-title" class="display">What clients say</h2>
      <p class="review-flag">Sample reviews (demo)</p>
    </div>
    <figure class="pull">
      <p class="stars" role="img" aria-label="5 out of 5 stars (sample)">
        <span aria-hidden="true">★★★★★</span>
      </p>
      <span class="qmark" aria-hidden="true">“</span>
      <blockquote>
        <p>“{lead.quote}”</p>
      </blockquote>
      <figcaption>
        <span class="who">{lead.name}</span>{' · '}{lead.service}{' · '}<em>sample</em>
      </figcaption>
    </figure>
    <div class="pull-side">
      {
        rest.map((review) => (
          <figure class="aside-quote">
            <p class="stars" role="img" aria-label="5 out of 5 stars (sample)">
              <span aria-hidden="true">★★★★★</span>
            </p>
            <blockquote>
              <p>“{review.quote}”</p>
            </blockquote>
            <figcaption>
              <span class="who">{review.name}</span>{' · '}{review.service}{' · '}<em>sample</em>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
