---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---
<Base title={`Page not found — ${site.name} (demo)`} description="This page could not be found on the Ironbark & Ivy demo salon website." noindex>
  <section class="section" aria-labelledby="nf-title">
    <div class="container-x max-w-2xl text-center">
      <svg class="mx-auto" width="140" height="140" viewBox="0 0 140 140" aria-hidden="true">
        <circle cx="70" cy="70" r="70" fill="#f4dfe1" />
        <g transform="translate(36 44)" fill="none" stroke="#4a2340" stroke-width="5" stroke-linecap="round">
          <circle cx="12" cy="12" r="11" /><circle cx="12" cy="44" r="11" /><path d="M22 18 68 46M22 38 68 10" />
        </g>
      </svg>
      <p class="eyebrow mt-8">Error 404</p>
      <h1 id="nf-title" class="mt-3 text-4xl font-semibold sm:text-5xl">Looks like this page got a trim.</h1>
      <p class="mt-5 text-lg text-muted">We couldn't find what you were looking for. Head back to the home page or jump straight to booking.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary">Back to home</a>
        <a href="/#services" class="btn btn-ghost">View services</a>
      </div>
    </div>
  </section>
</Base>
