---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---
<Base title={`Page not found — ${site.name} (demo)`} description="This page could not be found on the Ironbark & Ivy demo salon website." noindex>
  <section class="band" aria-labelledby="nf-title">
    <div class="container-x nf-grid">
      <svg class="nf-mark" viewBox="0 0 200 200" aria-hidden="true">
        <rect x="18" y="18" width="164" height="164" fill="#4a2340"></rect>
        <circle cx="78" cy="78" r="16" fill="none" stroke="#f4dfe1" stroke-width="4"></circle>
        <circle cx="78" cy="122" r="16" fill="none" stroke="#f4dfe1" stroke-width="4"></circle>
        <path d="M92 86 150 118M92 114 150 82" fill="none" stroke="#e8b4bc" stroke-width="4" stroke-linecap="round"></path>
      </svg>
      <div>
        <p class="ink-label">Error 404</p>
        <h1 id="nf-title" class="display">Looks like this page got a <em>trim.</em></h1>
        <p class="hero-lede">We couldn't find what you were looking for. Head back to the home page or jump straight to booking.</p>
        <div class="hero-actions">
          <a href="/" class="btn btn-primary">Back to home</a>
          <a href="/#services" class="btn btn-ghost">View services</a>
        </div>
      </div>
    </div>
  </section>
</Base>
